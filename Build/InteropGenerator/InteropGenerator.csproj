<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>Submerged.InteropGenerator</AssemblyName>
        <RootNamespace>Submerged.Build</RootNamespace>
        <Nullable>enable</Nullable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <PathMap>$(MSBuildProjectDirectory)=/_/Submerged.Build</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Il2CppInterop.Generator" Version="1.5.3" />
    </ItemGroup>

</Project>
